.home-profile {
  text-align: center;
  padding-top: 3rem;
  padding-bottom: 3rem;
}

.home-profile-logo {
  width: 160px;
  height: 160px;
  object-fit: cover;
  border-radius: 50%;
  display: block;
  margin: 0 auto 1.5rem auto;
}

.home-profile h1 {
  margin-bottom: 0.5rem;
  font-size: 2.5rem;
}

.home-profile-description {
  font-size: 1.1rem;
  opacity: 0.75;
  margin-bottom: 0.5rem;
}

.home-profile-motto {
  font-style: italic;
  opacity: 0.6;
}

.terminal {
  width: min(650px, 90vw);
  margin: 2rem auto;
  overflow: hidden;
  border-radius: 12px;
  background: #0d1117;
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.45),
    0 0 30px rgba(56, 189, 248, 0.08);

  text-align: left;
  font-family:
    "JetBrains Mono",
    "Fira Code",
    "Cascadia Code",
    monospace;
}

.terminal-header {
  display: flex;
  align-items: center;
  gap: 7px;
  height: 36px;
  padding: 0 14px;
  background: #161b22;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.terminal-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
}

.terminal-dot.red {
  background: #ff5f56;
}

.terminal-dot.yellow {
  background: #ffbd2e;
}

.terminal-dot.green {
  background: #27c93f;
}

.terminal-body {
  min-height: 180px;
  padding: 20px;
  color: #d1d5db;
  font-size: 0.9rem;
  line-height: 1.7;
}

.terminal-prompt {
  color: #38bdf8;
}

.terminal-line {
  color: #e5e7eb;
}

.terminal-output {
  margin-top: 4px;
  margin-bottom: 12px;
  color: #4ade80;
}

.terminal-cursor {
  color: #38bdf8;
  animation: terminal-blink 1s steps(2, start) infinite;
}

@keyframes terminal-blink {
  50% {
    opacity: 0;
  }
}

@media (max-width: 640px) {
  .terminal {
    width: 95vw;
  }

  .terminal-body {
    padding: 15px;
    font-size: 0.78rem;
  }
}

body {
  background: #000 !important;
}

## aaa
.prose {
  max-width: 72ch;
  line-height: 1.85;
  font-size: 1.05rem;
}

.prose p {
  margin-top: 1.5rem;
  margin-bottom: 1.5rem;
}

.prose h2 {
  margin-top: 3.5rem;
  margin-bottom: 1.5rem;
}

.prose ul {
  margin-top: 1rem;
  margin-bottom: 2rem;
}

.prose li {
  margin-top: 0.5rem;
}

.prose blockquote {
  margin-top: 2.5rem;
  margin-bottom: 2.5rem;
  font-size: 1.15rem;
}

